{
  "name": "@appear.sh/oas-zod-validator",
  "version": "1.9.0",
  "description": "OpenAPI Specification validator built with Zod",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "oas-validate": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/cli.{js,d.ts,cjs}",
    "dist/index.{js,d.ts,cjs}",
    "dist/schemas/*.{js,d.ts,cjs}",
    "dist/utils/*.{js,d.ts,cjs}",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/**/tests/**",
    "assets/",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "test:clean": "rimraf coverage && vitest run --coverage",
    "clean": "rimraf coverage && rimraf dist",
    "benchmark": "npm run build && node dist/utils/performance-benchmark.js",
    "benchmark:memory": "npm run build && node --expose-gc dist/utils/memory-benchmark.js",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "keywords": [
    "openapi",
    "swagger",
    "validation",
    "zod",
    "typescript",
    "cli"
  ],
  "author": "Appear.sh",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^13.1.0",
    "inquirer": "^9.3.8",
    "ora": "^8.0.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@eslint/js": "^9.24.0",
    "@types/chalk": "^0.4.31",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^22.13.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vitest": "^0.5.4",
    "glob": "^10.4.5",
    "globals": "^16.0.0",
    "jsonc-parser": "^3.3.1",
    "prettier": "^3.9.6",
    "rimraf": "^5.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
